# ============================================================
# V-Code Edu — cấu hình backend (sao chép thành .env rồi điền)
# KHÔNG commit tệp .env lên Git. Khóa API chỉ đặt ở đây hoặc
# trong biến môi trường của máy chủ — không bao giờ ở frontend.
# ============================================================

# --- Chung ---
APP_ENV=development
LOG_LEVEL=INFO
# Mặc định: SQLite tệp vcode_edu.db ở thư mục gốc dự án.
# MySQL: mysql+pymysql://user:pass@host:3306/vcode   (cần: pip install pymysql)
# PostgreSQL: postgresql://user:pass@host:5432/vcode (cần: pip install psycopg2-binary)
DATABASE_URL=

# --- Firebase (xác minh ID token của người dùng đã đăng nhập) ---
FIREBASE_PROJECT_ID=v-code-edu

# --- Web ---
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Để trống = mặc định an toàn.
ALLOWED_ORIGINS=
# 1 = backend phục vụ luôn frontend tại http://localhost:8000
SERVE_FRONTEND=1
# Thư mục chứa index.html (mặc định: thư mục gốc dự án)
FRONTEND_DIR=
# Đặt 1 CHỈ KHI chạy sau reverse proxy tin cậy (Nginx, Render, Railway...) để đọc X-Forwarded-For
TRUST_PROXY=0

# --- Trợ lý AI V-Mentor ---
# Thứ tự ưu tiên khi provider = auto
AI_PROVIDER_ORDER=gemini,openai,anthropic,ollama
AI_RATE_PER_MINUTE=12
AI_DAILY_LIMIT_USER=200
AI_DAILY_LIMIT_GUEST=30
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.4
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=60
AI_TOTAL_TIMEOUT=120

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (hoặc máy chủ tương thích OpenAI: LM Studio, vLLM...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# max_tokens (mặc định) hoặc max_completion_tokens (một số mô hình mới của OpenAI yêu cầu)
OPENAI_TOKEN_PARAM=max_tokens

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Mạnh nhất: claude-opus-5-5 · Tiết kiệm hơn: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama — AI chạy cục bộ, dùng được khi không có Internet (máy chủ trường / mạng LAN)
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
